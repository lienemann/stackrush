{
  "name": "stackrush",
  "version": "0.6.0",
  "private": true,
  "description": "Real-time card race for 2-4 players. PWA-first, serverless multiplayer.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "tsx --test packages/core/test/*.test.ts packages/net/test/*.test.ts packages/app/test/*.test.ts",
    "selfplay": "tsx packages/core/test/selfplay.ts && tsx packages/core/test/selfplay-variants.ts",
    "typecheck": "tsc -p packages/core && tsc -p packages/net && tsc -p packages/app",
    "build": "npm run build -w @stackrush/app",
    "dev": "npm run dev -w @stackrush/app",
    "preview": "npm run preview -w @stackrush/app",
    "icons": "node scripts/gen-icons.mjs"
  },
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
